---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Nav.astro";
---

<Layout title="Tu Carrito | Regalos Personalizados">
  <Navbar />
  <main class="max-w-4xl mx-auto px-4 pt-32 pb-20">
    <div class="text-center mb-16">
      <h1 class="text-3xl font-serif italic mb-2">Tu Carrito</h1>
      <div class="w-12 h-1px bg-neutral-300 mx-auto"></div>
    </div>

    <div id="cart-container">
      <div id="cart-items" class="space-y-4"></div>

      <div id="cart-empty" class="hidden text-center py-20">
        <p class="text-neutral-400 uppercase tracking-widest text-sm mb-8">
          Tu carrito está vacío
        </p>
        <a
          href="/"
          class="text-xs uppercase tracking-widest border-b border-neutral-900 pb-1 hover:text-neutral-500 hover:border-neutral-300 transition-colors"
        >
          Explorar Colección
        </a>
      </div>

      <div
        id="cart-summary"
        class="mt-16 pt-8 border-t border-neutral-100 hidden"
      >
        <div class="flex justify-between items-center mb-10">
          <span class="text-xs uppercase tracking-[0.2em] text-neutral-500"
            >Total estimado</span
          >
          <span id="total-price" class="text-2xl font-serif italic">$0 MXN</span
          >
        </div>

        <div class="flex flex-col gap-4">
          <div
            id="walletBrick_container"
            class="min-h-60px flex items-center justify-center bg-neutral-50 animate-pulse border border-neutral-100 transition-all duration-300"
          >
            <span class="text-[9px] uppercase tracking-widest text-neutral-400"
              >Preparando pago seguro...</span
            >
          </div>

          <button
            id="checkout-whatsapp"
            class="w-full border border-neutral-900 text-neutral-900 py-5 text-[11px] uppercase tracking-[0.3em] hover:bg-neutral-50 transition-all active:scale-[0.98] cursor-pointer"
          >
            Finalizar pedido por WhatsApp
          </button>
        </div>
        <p
          class="text-center text-[10px] text-neutral-400 mt-6 tracking-wider uppercase"
        >
          Los detalles de personalización se enviarán automáticamente por chat.
        </p>
      </div>
    </div>
  </main>
</Layout>

<script is:inline src="https://sdk.mercadopago.com/js/v2"></script>

<script>
  const initCart = () => {
    const itemsContainer = document.getElementById("cart-items");
    const emptyMessage = document.getElementById("cart-empty");
    const summary = document.getElementById("cart-summary");
    const totalPriceEl = document.getElementById("total-price");

    // Variable para controlar la instancia del botón de Mercado Pago
    let walletBrickController: any = null;

    // @ts-ignore
    const mp = new window.MercadoPago(import.meta.env.PUBLIC_MP_PUBLIC_KEY, {
      locale: "es-MX",
    });
    const bricksBuilder = mp.bricks();

    async function renderCart() {
      const cart = JSON.parse(localStorage.getItem("cart") || "[]");

      if (!itemsContainer || !emptyMessage || !summary || !totalPriceEl) return;

      if (cart.length === 0) {
        itemsContainer.innerHTML = "";
        emptyMessage.classList.remove("hidden");
        summary.classList.add("hidden");
        return;
      }

      emptyMessage.classList.add("hidden");
      summary.classList.remove("hidden");

      let total = 0;
      let html = "";

      cart.forEach((item: any, index: number) => {
        const price = Number(item.precio || item.price || 0);
        const qty = Number(item.quantity || 1);
        const subtotal = price * qty;
        total += subtotal;

        const p = item.personalizacion || {};
        const tieneFotos =
          p.fotos && Array.isArray(p.fotos) && p.fotos.length > 0;

        html += `
          <div class="flex items-start gap-4 py-6 border-b border-neutral-50 last:border-0">
            <div class="w-20 h-28 bg-neutral-50 flex-shrink-0">
              <img src="${item.imagen}" class="w-full h-full object-cover" onerror="this.src='/placeholder.jpg'"/>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex justify-between items-start">
                <h3 class="text-[11px] uppercase tracking-widest font-bold truncate">${item.nombre}</h3>
                <button class="remove-item text-neutral-300 hover:text-red-500 p-1 cursor-pointer" data-index="${index}">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M6 18L18 6M6 6l12 12" stroke-width="1.5"/></svg>
                </button>
              </div>
              <div class="mt-2 space-y-2">
                ${p.texto ? `<div class="bg-neutral-50 p-2 border-l border-neutral-300"><p class="text-[8px] uppercase tracking-widest text-neutral-400 mb-0.5">Grabado:</p><p class="text-[10px] italic text-neutral-600">"${p.texto}"</p></div>` : ""}
                ${tieneFotos ? `<div class="flex items-center gap-1"><p class="text-[9px] text-neutral-400 uppercase tracking-widest">📷 ${p.fotos.length} fotos seleccionadas</p></div>` : ""}
              </div>
              <div class="flex justify-between items-center mt-4">
                <div class="flex items-center border border-neutral-200">
                  <button class="qty-btn px-2 py-1 text-neutral-400 cursor-pointer" data-index="${index}" data-change="-1">-</button>
                  <span class="px-2 text-[10px] font-bold">${qty}</span>
                  <button class="qty-btn px-2 py-1 text-neutral-400 cursor-pointer" data-index="${index}" data-change="1">+</button>
                </div>
                <span class="font-serif italic text-neutral-900">$${subtotal}</span>
              </div>
            </div>
          </div>
        `;
      });

      itemsContainer.innerHTML = html;
      totalPriceEl.innerText = `$${total} MXN`;

      attachEventListeners();
      await handleMercadoPagoButton(cart);
    }

    async function handleMercadoPagoButton(cart: any[]) {
      const container = document.getElementById("walletBrick_container");
      if (!container) return;

      // 1. Desmontar el botón anterior si existe para evitar que se quede cargando
      if (walletBrickController) {
        walletBrickController.unmount();
        walletBrickController = null;
      }

      // 2. Mostrar estado de carga
      container.innerHTML =
        '<span class="text-[9px] uppercase tracking-widest text-neutral-400">Actualizando pago...</span>';
      container.classList.add("animate-pulse", "bg-neutral-50");

      try {
        const response = await fetch("/api/checkout", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ items: cart }),
        });

        const { id } = await response.json();

        if (id) {
          // 3. Crear el nuevo botón y guardar su controlador
          walletBrickController = await bricksBuilder.create(
            "wallet",
            "walletBrick_container",
            {
              initialization: {
                preferenceId: id,
                redirectMode: "modal",
              },
              callbacks: {
                onReady: () => {
                  // 4. Limpiar estilos de carga al estar listo
                  container.classList.remove(
                    "animate-pulse",
                    "bg-neutral-50",
                    "min-h-[60px]",
                  );
                  container.classList.add("min-h-0");
                  const text = container.querySelector("span");
                  if (text) text.remove();
                },
                onError: (error: any) => {
                  console.error("Error MP:", error);
                  container.innerHTML =
                    '<span class="text-[10px] text-red-500">Error al cargar el pago</span>';
                },
              },
              customization: {
                texts: { valueProp: "smart_option" },
                visual: {
                  buttonBackground: "black",
                  borderRadius: "0px",
                },
              },
            },
          );
        }
      } catch (e: any) {
        console.error("Error inicializando MP:", e);
      }
    }

    function attachEventListeners() {
      document.querySelectorAll(".qty-btn").forEach((el) => {
        (el as HTMLElement).onclick = (e) => {
          const target = e.currentTarget as HTMLElement;
          const idx = parseInt(target.dataset.index || "0");
          const change = parseInt(target.dataset.change || "0");
          updateQty(idx, change);
        };
      });

      document.querySelectorAll(".remove-item").forEach((el) => {
        (el as HTMLElement).onclick = (e) => {
          const target = e.currentTarget as HTMLElement;
          const idx = parseInt(target.dataset.index || "0");
          removeItem(idx);
        };
      });
    }

    function updateQty(index: number, change: number) {
      let cart = JSON.parse(localStorage.getItem("cart") || "[]");
      if (cart[index]) {
        cart[index].quantity = Math.max(
          1,
          (cart[index].quantity || 1) + change,
        );
        localStorage.setItem("cart", JSON.stringify(cart));
        renderCart();
        window.dispatchEvent(new Event("cart-updated"));
      }
    }

    function removeItem(index: number) {
      let cart = JSON.parse(localStorage.getItem("cart") || "[]");
      cart.splice(index, 1);
      localStorage.setItem("cart", JSON.stringify(cart));
      renderCart();
      window.dispatchEvent(new Event("cart-updated"));
    }

    const whatsappBtn = document.getElementById("checkout-whatsapp");
    if (whatsappBtn) {
      whatsappBtn.onclick = () => {
        const cart = JSON.parse(localStorage.getItem("cart") || "[]");
        let msg = "¡Hola! Me gustaría realizar un pedido personalizado:\n\n";
        cart.forEach((item: any, i: number) => {
          msg += `*${i + 1}. ${item.nombre}* (x${item.quantity})\n`;
          if (item.personalizacion?.texto)
            msg += `   - Grabado: "${item.personalizacion.texto}"\n`;
          if (item.personalizacion?.fotos?.length > 0)
            msg += `   - Fotos: ${item.personalizacion.fotos.length} archivo(s)\n`;
          msg += `   - Precio: $${Number(item.precio || item.price) * item.quantity} MXN\n\n`;
        });
        msg += `*TOTAL ESTIMADO: ${totalPriceEl?.innerText}*`;
        window.open(
          `https://wa.me/527551202205?text=${encodeURIComponent(msg)}`,
          "_blank",
        );
      };
    }

    renderCart();
  };

  initCart();
  document.addEventListener("astro:after-swap", initCart);
</script>
