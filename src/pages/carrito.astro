---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Nav.astro";

// PayPal url porque se pone de niñita el astro y no deja usar variables de entorno directamente en el src del script
const paypalClientId = import.meta.env.PUBLIC_PAYPAL_CLIENT_ID;
const paypalUrl = `https://www.paypal.com/sdk/js?client-id=${paypalClientId}&currency=MXN`;
---

<Layout title="Tu Carrito | Regalos Personalizados">
  <Navbar />
  <main class="max-w-4xl mx-auto px-4 pt-32 pb-20">
    <div class="text-center mb-16">
      <h1 class="text-3xl font-serif italic mb-2">Tu Carrito</h1>
      <div class="w-12 h-1px bg-neutral-300 mx-auto"></div>
    </div>

    <div id="cart-container">
      <div id="cart-items" class="space-y-4"></div>

      <div id="cart-empty" class="hidden text-center py-20">
        <p class="text-neutral-400 uppercase tracking-widest text-sm mb-8">
          Tu carrito está vacío
        </p>
        <a
          href="/"
          class="text-xs uppercase tracking-widest border-b border-neutral-900 pb-1 hover:text-neutral-500 hover:border-neutral-300 transition-colors"
        >
          Explorar Colección
        </a>
      </div>

      <div
        id="cart-summary"
        class="mt-16 pt-8 border-t border-neutral-100 hidden"
      >
        <div class="flex justify-between items-center mb-10">
          <span class="text-xs uppercase tracking-[0.2em] text-neutral-500"
            >Total estimado</span
          >
          <span id="total-price" class="text-2xl font-serif italic">$0 MXN</span
          >
        </div>

        <div class="flex flex-col gap-4">
          <div
            id="walletBrick_container"
            class="min-h-60px flex items-center justify-center bg-neutral-50 animate-pulse border border-neutral-100 transition-all duration-300"
          >
            <span class="text-[9px] uppercase tracking-widest text-neutral-400"
              >Preparando pago seguro...</span
            >
          </div>

          <div id="paypal-button-container"></div>

          <button
            id="checkout-whatsapp"
            class="w-full border border-neutral-900 text-neutral-900 py-5 text-[11px] uppercase tracking-[0.3em] hover:bg-neutral-50 transition-all active:scale-[0.98] cursor-pointer"
          >
            Finalizar pedido por WhatsApp
          </button>
        </div>
        <p
          class="text-center text-[10px] text-neutral-400 mt-6 tracking-wider uppercase"
        >
          Los detalles de personalización se enviarán automáticamente por chat.
        </p>
      </div>
    </div>
  </main>
</Layout>

<script is:inline src="https://sdk.mercadopago.com/js/v2"></script>
<script is:inline src={paypalUrl}></script>

<script>
  const initCart = () => {
    let walletBrickController: any = null;
    let mpTimeout: ReturnType<typeof setTimeout> | null = null;

    const itemsContainer = document.getElementById("cart-items");
    const emptyMessage = document.getElementById("cart-empty");
    const summary = document.getElementById("cart-summary");
    const totalPriceEl = document.getElementById("total-price");
    const mpContainer = document.getElementById("walletBrick_container");

    // @ts-ignore
    const mp = new window.MercadoPago(import.meta.env.PUBLIC_MP_PUBLIC_KEY, {
      locale: "es-MX",
    });
    const bricksBuilder = mp.bricks();

    async function handleMercadoPagoButton(cart: any[]) {
      if (!mpContainer || cart.length === 0) return;
      if (walletBrickController) {
        await walletBrickController.unmount();
        walletBrickController = null;
      }
      mpContainer.innerHTML =
        '<span class="text-[9px] uppercase tracking-widest text-neutral-400 italic">Generando botón de pago...</span>';
      mpContainer.classList.add("animate-pulse", "bg-neutral-50");

      try {
        const response = await fetch("/api/checkout", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ items: cart }),
        });
        const { id } = await response.json();
        if (!id) throw new Error("No ID");
        walletBrickController = await bricksBuilder.create(
          "wallet",
          "walletBrick_container",
          {
            initialization: { preferenceId: id, redirectMode: "modal" },
            callbacks: {
              onReady: () => {
                mpContainer.classList.remove("animate-pulse", "bg-neutral-50");
                const text = mpContainer.querySelector("span");
                if (text) text.remove();
              },
              onError: (e: any) => console.error("Error MP:", e),
            },
            customization: {
              visual: { buttonBackground: "black", borderRadius: "0px" },
            },
          },
        );
      } catch (e: any) {
        console.error("Fallo al cargar botón:", e);
        mpContainer.innerHTML =
          '<button onclick="location.reload()" class="text-[9px] uppercase underline text-red-500">Error al cargar pago. Reintentar.</button>';
      }
    }

    // --- LÓGICA DE PAYPAL ---
    const renderPayPal = (cart: any[]) => {
      const paypalContainer = document.getElementById(
        "paypal-button-container",
      );
      if (!paypalContainer) return;
      paypalContainer.innerHTML = ""; // Limpiar para evitar duplicados

      // @ts-ignore
      window.paypal
        .Buttons({
          style: {
            layout: "vertical",
            color: "black",
            shape: "rect",
            label: "paypal",
            borderRadius: 0,
          },
          createOrder: async () => {
            const res = await fetch("/api/paypal-checkout", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                items: cart.map((i) => ({ id: i.id, quantity: i.quantity })),
              }),
            });
            const order = await res.json();
            return order.id;
          },
          onApprove: async (data: any) => {
            const res = await fetch("/api/paypal-capture", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ orderID: data.orderID }),
            });
            const details = await res.json();
            if (details.status === "COMPLETED") {
              localStorage.removeItem("cart");
              window.location.href = "/success";
            }
          },
        })
        .render("#paypal-button-container");
    };

    function renderCart() {
      const cart = JSON.parse(localStorage.getItem("cart") || "[]");
      if (!itemsContainer || !emptyMessage || !summary || !totalPriceEl) return;

      if (cart.length === 0) {
        itemsContainer.innerHTML = "";
        emptyMessage.classList.remove("hidden");
        summary.classList.add("hidden");
        return;
      }

      emptyMessage.classList.add("hidden");
      summary.classList.remove("hidden");

      let total = 0;
      let html = "";
      cart.forEach((item: any, index: number) => {
        const price = Number(item.precio || item.price || 0);
        const qty = Number(item.quantity || 1);
        const subtotal = price * qty;
        total += subtotal;
        html += `
          <div class="flex items-start gap-4 py-6 border-b border-neutral-50 last:border-0">
            <div class="w-20 h-28 bg-neutral-50 flex-shrink-0">
              <img src="${item.imagen}" class="w-full h-full object-cover" onerror="this.src='/placeholder.jpg'"/>
            </div>
            <div class="flex-1">
              <div class="flex justify-between items-start">
                <h3 class="text-[11px] uppercase tracking-widest font-bold">${item.nombre}</h3>
                <button class="remove-item text-neutral-300 hover:text-red-500 text-[9px] uppercase tracking-tighter" data-index="${index}">Eliminar</button>
              </div>
              <div class="flex justify-between items-center mt-4">
                <div class="flex items-center border border-neutral-200">
                  <button class="qty-btn px-2 py-1" data-index="${index}" data-change="-1">-</button>
                  <span class="px-2 text-[10px] font-bold">${qty}</span>
                  <button class="qty-btn px-2 py-1" data-index="${index}" data-change="1">+</button>
                </div>
                <span class="font-serif italic text-neutral-900">$${subtotal}</span>
              </div>
            </div>
          </div>`;
      });

      itemsContainer.innerHTML = html;
      totalPriceEl.innerText = `$${total} MXN`;

      // Event Listeners
      document.querySelectorAll(".qty-btn").forEach((el) => {
        (el as HTMLElement).onclick = (e: any) => {
          const i = parseInt(e.target.dataset.index);
          const c = parseInt(e.target.dataset.change);
          const cartData = JSON.parse(localStorage.getItem("cart") || "[]");
          cartData[i].quantity = Math.max(1, (cartData[i].quantity || 1) + c);
          localStorage.setItem("cart", JSON.stringify(cartData));
          renderCart();
        };
      });

      document.querySelectorAll(".remove-item").forEach((el) => {
        (el as HTMLElement).onclick = (e: any) => {
          const i = parseInt(e.target.dataset.index);
          const cartData = JSON.parse(localStorage.getItem("cart") || "[]");
          cartData.splice(i, 1);
          localStorage.setItem("cart", JSON.stringify(cartData));
          renderCart();
        };
      });

      if (mpTimeout) clearTimeout(mpTimeout);
      mpTimeout = setTimeout(() => {
        handleMercadoPagoButton(cart);
        renderPayPal(cart);
      }, 800);
    }

    renderCart();
  };

  initCart();
  document.addEventListener("astro:after-swap", initCart);
</script>
