---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Nav.astro";

const paypalClientId = import.meta.env.PUBLIC_PAYPAL_CLIENT_ID;
---

<Layout title="Tu Carrito | Jenndart Pop">
  <Navbar />
  <main class="max-w-4xl mx-auto px-4 pt-32 pb-20">
    <div class="text-center mb-16">
      <h1 class="text-3xl font-serif italic mb-2">Tu Carrito</h1>
      <div class="w-12 h-1px bg-neutral-300 mx-auto"></div>
    </div>

    <div id="cart-container">
      <div id="cart-items" class="space-y-4"></div>

      <div id="cart-empty" class="hidden text-center py-20">
        <p class="text-neutral-400 uppercase tracking-widest text-sm mb-8">
          Tu carrito está vacío
        </p>
        <a
          href="/"
          class="text-xs uppercase tracking-widest border-b border-neutral-900 pb-1 hover:text-neutral-500 transition-colors"
          >Explorar Colección</a
        >
      </div>

      <div
        id="cart-summary"
        class="mt-16 pt-8 border-t border-neutral-100 hidden"
      >
        <div class="flex justify-between items-center mb-10">
          <span class="text-xs uppercase tracking-[0.2em] text-neutral-500"
            >Total estimado</span
          >
          <span id="total-price" class="text-2xl font-serif italic">$0 MXN</span
          >
        </div>

        <div class="flex flex-col gap-4 max-w-md mx-auto w-full">
          <div id="walletBrick_container" class="w-full min-h-[50px]"></div>
          <div id="paypal-button-container" class="w-full min-h-[50px]"></div>

          <button
            id="checkout-whatsapp"
            class="w-full border border-neutral-900 text-neutral-900 py-4 text-[11px] uppercase tracking-[0.3em] hover:bg-neutral-50 transition-all cursor-pointer"
          >
            Finalizar por WhatsApp
          </button>
        </div>
      </div>
    </div>
  </main>

  <div id="paypal-id-bridge" data-id={paypalClientId} class="hidden"></div>
</Layout>

<script is:inline src="https://sdk.mercadopago.com/js/v2"></script>

<script>
  const initCart = () => {
    const itemsContainer = document.getElementById("cart-items");
    const emptyMessage = document.getElementById("cart-empty");
    const summary = document.getElementById("cart-summary");
    const totalPriceEl = document.getElementById("total-price");

    let cart = JSON.parse(localStorage.getItem("cart") || "[]");

    if (cart.length === 0) {
      if (itemsContainer) itemsContainer.innerHTML = "";
      emptyMessage?.classList.remove("hidden");
      summary?.classList.add("hidden");
      return;
    }

    emptyMessage?.classList.add("hidden");
    summary?.classList.remove("hidden");

    // RENDERIZADO DE PRODUCTOS CON BOTONES +/-
    let total = 0;
    itemsContainer!.innerHTML = cart
      .map((item: any, index: number) => {
        const price = Number(item.precio || 0);
        const qty = Number(item.quantity || 1);
        total += price * qty;
        return `
        <div class="flex items-start gap-4 py-6 border-b border-neutral-50 last:border-0">
          <img src="${item.imagen}" class="w-20 h-28 object-cover bg-neutral-50" />
          <div class="flex-1">
            <div class="flex justify-between">
              <h3 class="text-[11px] uppercase font-bold">${item.nombre}</h3>
              <button class="remove-item text-neutral-400 hover:text-red-500 text-[9px] uppercase tracking-tighter" data-index="${index}">Eliminar</button>
            </div>
            <div class="flex justify-between items-center mt-4">
              <div class="flex items-center border border-neutral-200">
                <button class="qty-btn px-2 py-1" data-index="${index}" data-change="-1">-</button>
                <span class="px-3 text-[10px] font-bold">${qty}</span>
                <button class="qty-btn px-2 py-1" data-index="${index}" data-change="1">+</button>
              </div>
              <span class="font-serif italic text-neutral-900">$${price * qty}</span>
            </div>
          </div>
        </div>`;
      })
      .join("");

    totalPriceEl!.innerText = `$${total} MXN`;

    // --- LÓGICA DE PAGOS (Encapsulada) ---
    const loadPayments = async () => {
      // Mercado Pago
      try {
        // @ts-ignore
        const mp = new window.MercadoPago(
          import.meta.env.PUBLIC_MP_PUBLIC_KEY,
          { locale: "es-MX" },
        );
        const res = await fetch("/api/checkout", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ items: cart }),
        });
        const { id } = await res.json();
        if (id) {
          document.getElementById("walletBrick_container")!.innerHTML = "";
          await mp.bricks().create("wallet", "walletBrick_container", {
            initialization: { preferenceId: id, redirectMode: "modal" },
            customization: {
              visual: { buttonBackground: "black", borderRadius: "0" },
            },
          });
        }
      } catch (e) {
        console.error("Error MP:", e);
      }

      // PayPal
      try {
        const clientId =
          document.getElementById("paypal-id-bridge")?.dataset.id;
        if (
          clientId &&
          clientId !== "undefined" &&
          !document.getElementById("pp-script")
        ) {
          const script = document.createElement("script");
          script.id = "pp-script";
          script.src = `https://www.paypal.com/sdk/js?client-id=${clientId}&currency=MXN`;
          script.async = true;
          script.onload = () => {
            // @ts-ignore
            window.paypal
              .Buttons({
                style: {
                  layout: "vertical",
                  color: "black",
                  shape: "rect",
                  height: 45,
                  borderRadius: 0,
                },
                createOrder: async () => {
                  const res = await fetch("/api/paypal-checkout", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ items: cart }),
                  });
                  const data = await res.json();
                  return data.id;
                },
                onApprove: async (data: any) => {
                  const res = await fetch("/api/paypal-capture", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ orderID: data.orderID }),
                  });
                  if (res.ok) {
                    localStorage.removeItem("cart");
                    window.location.href = "/success";
                  }
                },
              })
              .render("#paypal-button-container");
          };
          document.head.appendChild(script);
        }
      } catch (e) {
        console.error("Error PP:", e);
      }
    };

    // Ejecutar carga de pagos
    loadPayments();

    // --- LISTENERS DE INTERACCIÓN ---
    document.querySelectorAll(".qty-btn").forEach((btn) => {
      (btn as HTMLElement).onclick = () => {
        const idx = parseInt((btn as HTMLElement).dataset.index!);
        const change = parseInt((btn as HTMLElement).dataset.change!);
        cart[idx].quantity = Math.max(1, (cart[idx].quantity || 1) + change);
        localStorage.setItem("cart", JSON.stringify(cart));
        initCart(); // Recargar vista
      };
    });

    document.querySelectorAll(".remove-item").forEach((btn) => {
      (btn as HTMLElement).onclick = () => {
        const idx = parseInt((btn as HTMLElement).dataset.index!);
        cart.splice(idx, 1);
        localStorage.setItem("cart", JSON.stringify(cart));
        initCart(); // Recargar vista
      };
    });
  };

  initCart();
  document.addEventListener("astro:after-swap", initCart);
</script>
