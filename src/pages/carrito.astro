---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Nav.astro";

const paypalClientId = import.meta.env.PUBLIC_PAYPAL_CLIENT_ID;
---

<Layout title="Tu Carrito | Regalos Personalizados">
  <Navbar />
  <main class="max-w-4xl mx-auto px-4 pt-32 pb-20">
    <div class="text-center mb-16">
      <h1 class="text-3xl font-serif italic mb-2">Tu Carrito</h1>
      <div class="w-12 h-1px bg-neutral-300 mx-auto"></div>
    </div>

    <div id="cart-container">
      <div id="cart-items" class="space-y-4"></div>

      <div id="cart-empty" class="hidden text-center py-20">
        <p class="text-neutral-400 uppercase tracking-widest text-sm mb-8">
          Tu carrito está vacío
        </p>
        <a
          href="/"
          class="text-xs uppercase tracking-widest border-b border-neutral-900 pb-1 hover:text-neutral-500 transition-colors"
          >Explorar Colección</a
        >
      </div>

      <div
        id="cart-summary"
        class="mt-16 pt-8 border-t border-neutral-100 hidden"
      >
        <div class="flex justify-between items-center mb-10">
          <span class="text-xs uppercase tracking-[0.2em] text-neutral-500"
            >Total estimado</span
          >
          <span id="total-price" class="text-2xl font-serif italic">$0 MXN</span
          >
        </div>

        <div class="flex flex-col gap-4">
          <div id="mp-box" class="w-full min-h-[50px]">
            <div id="walletBrick_container"></div>
          </div>

          <div class="paypal-container-secure">
            <div id="paypal-button-container"></div>
          </div>

          <button
            id="checkout-whatsapp"
            class="w-full border border-neutral-900 text-neutral-900 py-4 text-[11px] uppercase tracking-[0.3em] hover:bg-neutral-50 transition-all cursor-pointer"
          >
            Finalizar pedido por WhatsApp
          </button>
        </div>
      </div>
    </div>
  </main>

  <div id="paypal-id-bridge" data-id={paypalClientId} class="hidden"></div>
</Layout>

<style>
  /* Forzado de anchos para que coincidan con WhatsApp */
  .paypal-container-secure {
    width: 100% !important;
    min-height: 50px;
  }
  #paypal-button-container {
    width: 100% !important;
  }
</style>

<script is:inline src="https://sdk.mercadopago.com/js/v2"></script>

<script is:inline>
  // Carga de PayPal con retraso para dejar que MP respire
  window.addEventListener("load", () => {
    setTimeout(() => {
      const bridge = document.getElementById("paypal-id-bridge");
      const clientId = bridge ? bridge.getAttribute("data-id") : null;
      if (clientId && clientId !== "undefined") {
        const script = document.createElement("script");
        script.src =
          "https://www.paypal.com/sdk/js?client-id=" +
          clientId +
          "&currency=MXN&components=buttons";
        script.async = true;
        script.onload = () =>
          window.dispatchEvent(new Event("paypal-ready-to-render"));
        document.head.appendChild(script);
      }
    }, 2000); // 2 segundos de espera
  });
</script>

<script>
  const initCart = () => {
    const mpKey = import.meta.env.PUBLIC_MP_PUBLIC_KEY;
    // @ts-ignore
    const mp = new window.MercadoPago(mpKey, { locale: "es-MX" });
    let walletBrickController: any = null;

    async function startMercadoPago(cart: any[]) {
      const container = document.getElementById("walletBrick_container");
      if (!container) return;
      if (walletBrickController) await walletBrickController.unmount();

      try {
        const res = await fetch("/api/checkout", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ items: cart }),
        });
        const { id } = await res.json();

        walletBrickController = await mp
          .bricks()
          .create("wallet", "walletBrick_container", {
            initialization: { preferenceId: id, redirectMode: "modal" },
            customization: {
              visual: { buttonBackground: "black", borderRadius: "0px" },
            },
          });
      } catch (e) {
        console.error("Error MP:", e);
      }
    }

    const startPayPal = (cart: any[]) => {
      // @ts-ignore
      if (!window.paypal) return;
      document.getElementById("paypal-button-container")!.innerHTML = "";

      // @ts-ignore
      window.paypal
        .Buttons({
          style: {
            layout: "vertical",
            color: "black",
            shape: "rect",
            height: 50,
            borderRadius: 0,
          },
          createOrder: async () => {
            const res = await fetch("/api/paypal-checkout", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ items: cart }),
            });
            const order = await res.json();
            return order.id;
          },
          onApprove: async (data: any) => {
            const res = await fetch("/api/paypal-capture", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ orderID: data.orderID }),
            });
            if (res.ok) {
              localStorage.removeItem("cart");
              window.location.href = "/success";
            }
          },
        })
        .render("#paypal-button-container");
    };

    function renderAll() {
      const cart = JSON.parse(localStorage.getItem("cart") || "[]");
      if (cart.length === 0) return;

      // MP carga primero
      startMercadoPago(cart);

      // PayPal espera a su evento
      // @ts-ignore
      if (window.paypal) {
        startPayPal(cart);
      } else {
        window.addEventListener(
          "paypal-ready-to-render",
          () => startPayPal(cart),
          { once: true },
        );
      }
    }

    // Pequeño delay inicial para el DOM
    setTimeout(renderAll, 500);
  };

  initCart();
  document.addEventListener("astro:after-swap", initCart);
</script>
