---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Nav.astro";
---

<Layout title="Tu Carrito | Regalos Personalizados">
  <Navbar />
  <main class="max-w-4xl mx-auto px-4 pt-32 pb-20">
    <div class="text-center mb-16">
      <h1 class="text-3xl font-serif italic mb-2">Tu Carrito</h1>
      <div class="w-12 h-1px bg-neutral-300 mx-auto"></div>
    </div>

    <div id="cart-container">
      <div id="cart-items" class="space-y-8"></div>

      <div id="cart-empty" class="hidden text-center py-20">
        <p class="text-neutral-400 uppercase tracking-widest text-sm mb-8">
          Tu carrito está vacío
        </p>
        <a
          href="/"
          class="text-xs uppercase tracking-widest border-b border-neutral-900 pb-1 hover:text-neutral-500 hover:border-neutral-300 transition-colors"
        >
          Explorar Colección
        </a>
      </div>

      <div
        id="cart-summary"
        class="mt-16 pt-8 border-t border-neutral-100 hidden"
      >
        <div class="flex justify-between items-center mb-10">
          <span class="text-xs uppercase tracking-[0.2em] text-neutral-500"
            >Total estimado</span
          >
          <span id="total-price" class="text-2xl font-serif italic">$0 MXN</span
          >
        </div>

        <div class="flex flex-col gap-4">
          <button
            id="checkout-mercadopago"
            class="w-full bg-neutral-900 text-white py-5 text-[11px] uppercase tracking-[0.3em] hover:bg-neutral-800 transition-all active:scale-[0.98] flex items-center justify-center gap-2 cursor-pointer"
          >
            Pagar con Mercado Pago
          </button>

          <button
            id="checkout-whatsapp"
            class="w-full border border-neutral-900 text-neutral-900 py-5 text-[11px] uppercase tracking-[0.3em] hover:bg-neutral-50 transition-all active:scale-[0.98] cursor-pointer"
          >
            Finalizar pedido por WhatsApp
          </button>
        </div>

        <p
          class="text-center text-[10px] text-neutral-400 mt-6 tracking-wider uppercase"
        >
          Si necesitas personalización especial, te recomendamos usar el botón
          de WhatsApp.
        </p>
      </div>
    </div>
  </main>
</Layout>

<script>
  const itemsContainer = document.getElementById("cart-items");
  const emptyMessage = document.getElementById("cart-empty");
  const summary = document.getElementById("cart-summary");
  const totalPriceEl = document.getElementById("total-price");

  function renderCart() {
    const cart = JSON.parse(localStorage.getItem("cart") || "[]");

    if (cart.length === 0) {
      if (itemsContainer) itemsContainer.innerHTML = "";
      emptyMessage?.classList.remove("hidden");
      summary?.classList.add("hidden");
      return;
    }

    emptyMessage?.classList.add("hidden");
    summary?.classList.remove("hidden");

    let total = 0;
    if (itemsContainer) {
      itemsContainer.innerHTML = cart
        .map((item: any, index: number) => {
          const price = item.precio || item.price || 0;
          total += price * item.quantity;

          return `
          <div class="flex items-center gap-6 py-6 border-b border-neutral-50 last:border-0">
            <div class="w-24 h-32 bg-neutral-50 overflow-hidden">
              <img src="${item.imagen}" alt="${item.nombre}" class="w-full h-full object-cover" />
            </div>
            
            <div class="flex-1">
              <div class="flex justify-between items-start mb-2">
                <h3 class="text-xs uppercase tracking-widest font-medium text-neutral-900">${item.nombre}</h3>
                <button onclick="window.removeItem(${index})" class="text-neutral-300 hover:text-red-400 transition-colors">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M6 18L18 6M6 6l12 12" stroke-width="1.5"/></svg>
                </button>
              </div>
              
              <p class="text-xs text-neutral-400 mb-6">${item.categoria || "Regalo"}</p>
              
              <div class="flex justify-between items-center">
                <div class="flex items-center border border-neutral-200">
                  <button onclick="window.updateQty(${index}, -1)" class="px-3 py-1 text-neutral-400 hover:text-black">-</button>
                  <span class="px-2 text-xs font-medium w-8 text-center">${item.quantity}</span>
                  <button onclick="window.updateQty(${index}, 1)" class="px-3 py-1 text-neutral-400 hover:text-black">+</button>
                </div>
                <span class="font-serif italic text-neutral-900">$${price * item.quantity}</span>
              </div>
            </div>
          </div>
        `;
        })
        .join("");
    }

    if (totalPriceEl) totalPriceEl.innerText = `$${total} MXN`;
  }

  (window as any).removeItem = (index: number) => {
    let cart = JSON.parse(localStorage.getItem("cart") || "[]");
    cart.splice(index, 1);
    localStorage.setItem("cart", JSON.stringify(cart));
    renderCart();
    window.dispatchEvent(new Event("cart-updated"));
  };

  (window as any).updateQty = (index: number, change: number) => {
    let cart = JSON.parse(localStorage.getItem("cart") || "[]");
    cart[index].quantity += change;
    if (cart[index].quantity < 1) cart[index].quantity = 1;
    localStorage.setItem("cart", JSON.stringify(cart));
    renderCart();
    window.dispatchEvent(new Event("cart-updated"));
  };

  // Botón Mercado Pago (Pendiente implementación API)
  document
    .getElementById("checkout-mercadopago")
    ?.addEventListener("click", () => {
      console.log("Iniciando flujo de Mercado Pago...");
      alert(
        "Mañana configuraremos la API de Mercado Pago para procesar tu pago de forma segura.",
      );
    });

  // Lógica del Botón de WhatsApp
  document
    .getElementById("checkout-whatsapp")
    ?.addEventListener("click", () => {
      const cart = JSON.parse(localStorage.getItem("cart") || "[]");
      let mensaje =
        "¡Hola! Me gustaría cotizar un pedido especial de los siguientes productos:\n\n";

      cart.forEach((item: any) => {
        mensaje += `• ${item.nombre} x${item.quantity} - $${(item.precio || item.price) * item.quantity} MXN\n`;
      });

      const total = totalPriceEl?.innerText;
      mensaje += `\n*Total: ${total}*\n\nMe gustaría acordar los detalles de personalización.`;

      const numero = "527551202205";
      window.open(
        `https://wa.me/${numero}?text=${encodeURIComponent(mensaje)}`,
        "_blank",
      );
    });

  renderCart();
</script>
