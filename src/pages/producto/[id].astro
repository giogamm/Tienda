---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Nav.astro";
import { db } from "../../lib/firebase";
import { doc, getDoc } from "firebase/firestore";

const { id } = Astro.params;

if (!id) return Astro.redirect("/404");

const docRef = doc(db, "productos", id);
const docSnap = await getDoc(docRef);

if (!docSnap.exists()) return Astro.redirect("/404");

const product = { id: docSnap.id, ...(docSnap.data() as any) };
---

<Layout title={`${product.nombre} | Tienda`}>
  <Navbar />
  <main class="max-w-7xl mx-auto px-4 pt-32 pb-20">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-16">
      <div class="bg-gray-50 overflow-hidden group">
        <img
          src={product.imagen}
          alt={product.nombre}
          class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
        />
      </div>

      <div class="flex flex-col justify-center">
        <p class="text-[10px] uppercase tracking-[0.4em] text-gray-400 mb-4">
          {product.categoria || "Personalizado"}
        </p>
        <h1 class="text-4xl font-serif italic mb-6 text-black">
          {product.nombre}
        </h1>
        <p class="text-2xl mb-8 font-light">
          ${product.price || product.precio} MXN
        </p>

        <div
          class="border-t border-gray-100 py-8 mb-8 text-gray-600 font-light leading-relaxed text-sm"
        >
          {product.descripcion}
        </div>

        <div class="flex flex-col space-y-4">
          <button
            id="add-to-cart"
            data-product={JSON.stringify(product)}
            class="border border-black text-black w-full py-5 text-[11px] uppercase tracking-[0.3em] hover:bg-black/85 hover:text-white transition-all duration-300 active:scale-[0.98]"
          >
            Añadir al carrito
          </button>

          <button
            id="buy-now"
            data-product={JSON.stringify(product)}
            class="border border-black[] text-black w-full py-5 text-[11px] uppercase tracking-[0.3em] hover:bg-black/85 hover:text-white transition-all duration-300 active:scale-[0.98]"
          >
            Comprar ahora
          </button>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  // Lógica reutilizable para guardar en el carrito
  const addToCart = (productData: any) => {
    let cart = JSON.parse(localStorage.getItem("cart") || "[]");
    const index = cart.findIndex((item: any) => item.id === productData.id);

    if (index > -1) {
      cart[index].quantity += 1;
    } else {
      cart.push({ ...productData, quantity: 1 });
    }

    localStorage.setItem("cart", JSON.stringify(cart));

    // Disparamos el evento para que el Navbar se actualice
    window.dispatchEvent(new Event("cart-updated"));
  };

  // Configurar botón "Añadir al carrito"
  const btnAdd = document.getElementById("add-to-cart");
  btnAdd?.addEventListener("click", () => {
    const data = JSON.parse(btnAdd.getAttribute("data-product") || "{}");
    addToCart(data);

    // Opcional: Cambiar texto del botón temporalmente
    const originalText = btnAdd.innerText;
    btnAdd.innerText = "¡AÑADIDO!";
    setTimeout(() => (btnAdd.innerText = originalText), 2000);
  });

  // Configurar botón "Comprar ahora"
  const btnBuy = document.getElementById("buy-now");
  btnBuy?.addEventListener("click", () => {
    const data = JSON.parse(btnBuy.getAttribute("data-product") || "{}");
    addToCart(data);
    window.location.href = "/carrito"; // Redirección inmediata
  });
</script>
