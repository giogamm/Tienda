<section class="relative h-screen w-full overflow-hidden bg-gray-100">
  <div
    id="slider"
    class="flex h-full w-full relative transition-transform duration-700 ease-[cubic-bezier(0.23,1,0.32,1)]"
  >
    <div class="min-w-full h-full relative shrink-0">
      <img
        src="https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fit=crop&q=80&w=2000"
        class="absolute inset-0 w-full h-full object-cover"
        alt="Texturas Minimalistas"
        loading="eager"
        fetchpriority="high"
      />
      <div
        class="absolute inset-0 bg-black/20 flex flex-col justify-center items-center text-white text-center px-4 pointer-events-none"
      >
        <h2
          class="text-[12px] tracking-[0.5em] uppercase mb-4 font-sans animate-fade-in animate-duration-500"
        >
          Regalos Personalizados
        </h2>
        <p
          class="text-5xl md:text-7xl font-serif italic tracking-tighter animate-fade-in animate-duration-500"
        >
          Detalles Únicos
        </p>
        <div class="mt-8 w-10 h-1px bg-white/40"></div>
      </div>
    </div>

    <div class="min-w-full h-full relative shrink-0">
      <img
        src="https://images.unsplash.com/photo-1513694203232-719a280e022f?auto=format&fit=crop&q=80&w=2000"
        class="absolute inset-0 w-full h-full object-cover"
        alt="Diseño de Interiores"
      />
      <div
        class="absolute inset-0 bg-black/30 flex flex-col justify-center items-center text-white text-center px-4 pointer-events-none"
      >
        <h2 class="text-[12px] tracking-[0.5em] uppercase mb-4 font-sans">
          Más que un regalo
        </h2>
        <p class="text-5xl md:text-7xl font-serif italic tracking-tighter">
          Una experiencia
        </p>
        <div class="mt-8 w-10 h-1px bg-white/40"></div>
      </div>
    </div>
  </div>

  <button
    id="prev"
    class="absolute left-8 top-1/2 -translate-y-1/2 text-white/50 hover:text-white transition-all z-20 cursor-pointer bg-transparent border-none"
  >
    <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor"
      ><path stroke-width="1" d="M15 19l-7-7 7-7"></path></svg
    >
  </button>
  <button
    id="next"
    class="absolute right-8 top-1/2 -translate-y-1/2 text-white/50 hover:text-white transition-all z-20 cursor-pointer bg-transparent border-none"
  >
    <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor"
      ><path stroke-width="1" d="M9 5l7 7-7 7"></path></svg
    >
  </button>

  <div
    id="dots-container"
    class="absolute bottom-10 left-1/2 -translate-x-1/2 flex space-x-3 z-20"
  >
    <div
      class="dot h-1 bg-white transition-all duration-500 cursor-pointer w-6 opacity-100 rounded-full"
    >
    </div>
    <div
      class="dot h-1 bg-white transition-all duration-500 cursor-pointer w-2 opacity-20 rounded-full"
    >
    </div>
  </div>
</section>

<script>
  function setupCarousel() {
    const slider = document.getElementById("slider");
    const dots = document.querySelectorAll(".dot");
    const nextBtn = document.getElementById("next");
    const prevBtn = document.getElementById("prev");

    if (!slider) return;

    let currentIndex = 0;
    const totalSlides = 2;
    // SOLUCIÓN AL ERROR DE TIPO: Usamos 'any' o 'ReturnType<typeof setInterval>'
    let interval: any;

    function updateSlider() {
      if (slider)
        slider.style.transform = `translateX(-${currentIndex * 100}%)`;
      dots.forEach((dot, i) => {
        const d = dot as HTMLElement;
        d.style.width = i === currentIndex ? "24px" : "8px";
        d.style.opacity = i === currentIndex ? "1" : "0.2";
      });
    }

    const startAutoplay = () => {
      clearInterval(interval);
      interval = setInterval(() => {
        currentIndex = (currentIndex + 1) % totalSlides;
        updateSlider();
      }, 5000);
    };

    nextBtn?.addEventListener("click", () => {
      currentIndex = (currentIndex + 1) % totalSlides;
      updateSlider();
      startAutoplay();
    });

    prevBtn?.addEventListener("click", () => {
      currentIndex = (currentIndex - 1 + totalSlides) % totalSlides;
      updateSlider();
      startAutoplay();
    });

    startAutoplay();
  }

  // Se ejecuta al cargar la página
  setupCarousel();
  // Se ejecuta cada vez que navegas (Soluciona que deje de funcionar al dar clic a Inicio)
  document.addEventListener("astro:page-load", setupCarousel);
</script>

<style>
  .font-serif {
    font-family: "Playfair Display", serif;
  }
  /* El aspect-ratio en CSS evita el salto de carga */
  #slider {
    aspect-ratio: 16/9;
    will-change: transform;
  }
  @media (max-width: 768px) {
    #slider {
      aspect-ratio: 3/5;
    }
  }
</style>
