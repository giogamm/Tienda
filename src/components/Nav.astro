<script>
  function updateCartCount() {
    const cart = JSON.parse(localStorage.getItem("cart") || "[]");

    // Añadimos ": number" al acc y al valor inicial (0)
    const totalItems = cart.reduce((acc: number, item: any) => {
      return acc + (item.quantity || 0);
    }, 0);

    const countElement = document.getElementById("cart-count");
    if (countElement) {
      countElement.innerText = `(${totalItems})`;
    }
  }
  // 1. Actualizar al cargar la página por primera vez
  updateCartCount();

  // 2. Escuchar cambios desde otras pestañas
  window.addEventListener("storage", updateCartCount);

  // 3. LA CLAVE: Escuchar el evento que disparamos desde el botón de la página de producto
  window.addEventListener("cart-updated", updateCartCount);
</script>
